{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mawburn.github.io/tech-feed/schemas/common.v1.schema.json",
  "title": "Tech Feed shared definitions, v1",
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "httpUrl": {
      "type": "string",
      "pattern": "^https?://[^\\s/]+",
      "format": "uri"
    },
    "nonEmptyText": {
      "type": "string",
      "pattern": "\\S"
    },
    "sourceLink": {
      "type": "object",
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/httpUrl"
        }
      }
    },
    "communityLink": {
      "type": "object",
      "required": [
        "platform",
        "url"
      ],
      "properties": {
        "platform": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "url": {
          "$ref": "#/$defs/httpUrl"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "communityLinks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/communityLink"
      }
    },
    "image": {
      "description": "Publisher Open Graph image. url/alt/credit/sourceUrl come from discovery or the scheduler; local/width/height/sha256 are added by the image pipeline in GitHub Actions.",
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/httpUrl"
        },
        "alt": {
          "type": "string"
        },
        "credit": {
          "type": "string"
        },
        "sourceUrl": {
          "$ref": "#/$defs/httpUrl"
        },
        "local": {
          "type": "string",
          "pattern": "^img/[0-9a-f]{20}\\.(webp|svg)$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "dependentRequired": {
        "local": [
          "width",
          "height",
          "sha256"
        ]
      }
    },
    "discoveryAudit": {
      "type": "object",
      "description": "Optional editorial research audit. Actual checks only; never fabricate timestamps, candidate counts, or incident claims.",
      "required": [
        "checkedAt",
        "windowStart",
        "windowEnd",
        "sources"
      ],
      "properties": {
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "windowStart": {
          "type": "string",
          "format": "date-time"
        },
        "windowEnd": {
          "type": "string",
          "format": "date-time"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "status"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/nonEmptyText"
              },
              "status": {
                "enum": [
                  "checked",
                  "partial",
                  "unavailable"
                ]
              },
              "candidateCount": {
                "type": "integer",
                "minimum": 0
              },
              "url": {
                "$ref": "#/$defs/httpUrl"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "majorIncidentsConsidered": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "decision",
              "reason"
            ],
            "properties": {
              "title": {
                "$ref": "#/$defs/nonEmptyText"
              },
              "decision": {
                "enum": [
                  "top-story",
                  "also-worth",
                  "excluded"
                ]
              },
              "reason": {
                "$ref": "#/$defs/nonEmptyText"
              },
              "status": {
                "enum": [
                  "active",
                  "resolved",
                  "uncertain"
                ]
              },
              "sourceUrl": {
                "$ref": "#/$defs/httpUrl"
              }
            }
          }
        },
        "rankingNotes": {
          "type": "string"
        }
      }
    },
    "contentFormat": {
      "type": "string",
      "description": "Optional content-format label for an 'AI & tooling in practice' entry, e.g. Video tutorial, Workflow, Experiment, Case study, Technical writeup, Demo, Source code, Show HN. Free text so new formats never break validation.",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "\\S"
    },
    "briefing": {
      "type": "array",
      "description": "Optional original source-grounded expanded briefing; 2-6 titled explanatory sections. Older editions may omit it.",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "heading",
          "body"
        ],
        "properties": {
          "heading": {
            "$ref": "#/$defs/nonEmptyText"
          },
          "body": {
            "$ref": "#/$defs/nonEmptyText"
          }
        }
      }
    }
  }
}
