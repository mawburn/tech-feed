{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mawburn.github.io/tech-feed/schemas/daily.v1.schema.json",
  "title": "Daily briefing (data/daily/YYYY-MM-DD.json), v1",
  "description": "Written by the scheduler. Additional properties are allowed so the scheduler can evolve without breaking validation.",
  "type": "object",
  "required": [
    "date",
    "overview",
    "marketPulse",
    "topStories",
    "alsoWorthKnowing",
    "newTools"
  ],
  "properties": {
    "date": {
      "$ref": "common.v1.schema.json#/$defs/isoDate"
    },
    "label": {
      "type": "string"
    },
    "overview": {
      "$ref": "common.v1.schema.json#/$defs/nonEmptyText"
    },
    "marketPulse": {
      "description": "Plain text, or an object whose summary and optional business/jobs/watch strings are rendered as paragraphs.",
      "anyOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["summary"],
          "properties": {
            "summary": { "type": "string" },
            "business": { "type": "string" },
            "jobs": { "type": "string" },
            "watch": { "type": "string" }
          }
        }
      ]
    },
    "discoveryAudit": {
      "$ref": "common.v1.schema.json#/$defs/discoveryAudit"
    },
    "topStories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/story"
      }
    },
    "alsoWorthKnowing": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/story"
      }
    },
    "newTools": {
      "description": "Section 'AI & tooling in practice' (key kept for compatibility). Any number of entries, including none; there is no editorial or schema cap.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/story"
      }
    }
  },
  "$defs": {
    "story": {
      "type": "object",
      "required": [
        "title",
        "summary",
        "category",
        "sources"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "common.v1.schema.json#/$defs/nonEmptyText"
        },
        "category": {
          "$ref": "common.v1.schema.json#/$defs/nonEmptyText"
        },
        "summary": {
          "$ref": "common.v1.schema.json#/$defs/nonEmptyText"
        },
        "format": {
          "$ref": "common.v1.schema.json#/$defs/contentFormat"
        },
        "whyItMatters": {
          "type": "string"
        },
        "limitations": {
          "type": "string"
        },
        "isUpdate": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.v1.schema.json#/$defs/sourceLink"
          }
        },
        "discoveredVia": {
          "$ref": "common.v1.schema.json#/$defs/communityLinks"
        },
        "discussions": {
          "$ref": "common.v1.schema.json#/$defs/communityLinks"
        },
        "image": {
          "$ref": "common.v1.schema.json#/$defs/image"
        },
        "briefing": {
          "$ref": "common.v1.schema.json#/$defs/briefing"
        },
        "incidentId": {
          "$ref": "common.v1.schema.json#/$defs/incidentId",
          "description": "Optional link to data/incidents/<incidentId>.json. The incident record is the single source of truth for status, timeline and fixes."
        }
      }
    }
  }
}
