<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#090c10">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <meta name="author" content="mawburn">
  <meta name="description" content="{{ pageDescription or 'Daily and weekly briefings covering AI, software engineering, security, technology markets and developer tools.' }}">
  <title>{{ pageTitle or 'Technology and AI news' }} | mawburn Feed</title>
  <link rel="canonical" href="{{ projectSite.baseUrl }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="mawburn Feed">
  <meta property="og:title" content="{{ pageTitle or 'Technology and AI news' }}">
  <meta property="og:description" content="{{ pageDescription or 'Source-linked daily and weekly tech news.' }}">
  <meta property="og:url" content="{{ projectSite.baseUrl }}{{ page.url }}">
  <meta name="twitter:card" content="summary">
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"mawburn Feed","url":"https://mawburn.github.io/tech-feed/","description":"Daily and weekly source-linked AI, technology and software engineering news."}</script>
  <link rel="icon" type="image/svg+xml" href="{{ '/assets/favicon.svg' | siteUrl }}">
  <link rel="stylesheet" href="{{ '/assets/styles.css' | siteUrl }}">
  <link rel="alternate" type="application/json" href="{{ '/data/briefings.json' | siteUrl }}" title="Structured daily news">
  <link rel="alternate" type="application/json" href="{{ '/data/weekly.json' | siteUrl }}" title="Structured weekly summaries">
  <link rel="alternate" type="text/plain" href="{{ '/llms.txt' | siteUrl }}" title="LLM-readable site index">
</head>
<body>
<a href="#feed" class="skip-link">Skip to news</a>
<div class="shell">
  <header class="site-header">
    <a href="{{ '/' | siteUrl }}" class="brand" aria-label="mawburn feed home">
      <span class="brand-mark" aria-hidden="true">m<span class="brand-mark-slash">/</span></span>
      <span class="brand-name">MAWBURN<span class="brand-slash"> / </span>FEED</span>
    </a>
    <nav class="header-navigation" aria-label="Feed sections">
      <a href="{{ '/' | siteUrl }}" {% if activeTab == 'daily' %}aria-current="page"{% endif %}>Daily briefings</a>
      <a href="{{ '/weekly.html' | siteUrl }}" {% if activeTab == 'weekly' %}aria-current="page"{% endif %}>Weekly summary</a>
    </nav>
  </header>
  {{ content | safe }}
  <footer class="footer">
    <span>© mawburn</span>
    <span>Primary sources · Static HTML</span>
    <span><a href="{{ '/weekly.html' | siteUrl }}">Sunday summary ↗</a></span>
  </footer>
</div>
</body>
</html>
