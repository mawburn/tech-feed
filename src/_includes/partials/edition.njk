{% set top = issue.topStories | matchesCategory(filterCategory) %}
{% set also = issue.alsoWorthKnowing | matchesCategory(filterCategory) %}
{% set tools = issue.newTools | matchesCategory(filterCategory) %}
{% if top.length or also.length or tools.length %}
<section class="edition" id="edition-{{ issue.date }}">
  <header class="edition-header">
    <p class="edition-kicker">{{ issue.label or 'Daily briefing' }}</p>
    <h2 class="edition-date">{{ issue.date | dateFull }}</h2>
    {% if not filterCategory and issue.overview %}<p class="edition-overview">{{ issue.overview }}</p>{% endif %}
  </header>
  {% if top.length %}
  <section class="edition-section">
    <h3 class="section-label">Top stories</h3>
    {% for story in top %}
    {% set secondary = false %}
    <article class="story{% if not story.image %} no-image{% endif %}">
      {% include "partials/story-image.njk" %}
      <div class="story-content">
        <div class="story-header">
          <span class="story-rank">{{ (story.rank or loop.index) | pad2 }}</span>
          <span class="story-category">{{ story.category or 'Technology' }}</span>
          {% if story.isUpdate %}<span class="story-updated">UPDATED</span>{% endif %}
        </div>
        <h4 class="story-title">{{ story.title }}</h4>
        {% if story.summary %}<p class="story-summary">{{ story.summary }}</p>{% endif %}
        {% if story.whyItMatters %}<p class="story-insight"><strong>Why it matters: </strong>{{ story.whyItMatters }}</p>{% endif %}
        {% if story.limitations %}<p class="story-insight story-limit"><strong>Caveat: </strong>{{ story.limitations }}</p>{% endif %}
      </div>
      <div class="story-links">{% include "partials/story-sources.njk" %}</div>
    </article>
    {% endfor %}
  </section>
  {% endif %}
  {% if also.length %}
  <section class="edition-section">
    <h3 class="section-label">Also worth knowing</h3>
    {% for story in also %}
    {% set secondary = true %}
    <article class="secondary-story{% if not story.image %} no-image{% endif %}">
      {% include "partials/story-image.njk" %}
      <div class="secondary-copy">
        <div class="secondary-header"><h4 class="secondary-title">{{ story.title }}</h4><span class="secondary-category">{{ story.category or 'Technology' }}</span></div>
        {% if story.summary %}<p>{{ story.summary }}</p>{% endif %}
        {% include "partials/story-sources.njk" %}
      </div>
    </article>
    {% endfor %}
  </section>
  {% endif %}
  {% if tools.length %}
  <section class="edition-section">
    <h3 class="section-label">Tools, models &amp; repositories</h3>
    {% for story in tools %}
    {% set secondary = true %}
    <article class="secondary-story{% if not story.image %} no-image{% endif %}">
      {% include "partials/story-image.njk" %}
      <div class="secondary-copy">
        <div class="secondary-header"><h4 class="secondary-title">{{ story.title }}</h4><span class="secondary-category">{{ story.category or 'Technology' }}</span></div>
        {% if story.summary %}<p>{{ story.summary }}</p>{% endif %}
        {% include "partials/story-sources.njk" %}
      </div>
    </article>
    {% endfor %}
  </section>
  {% endif %}
  {% if not filterCategory and issue.marketPulse %}
  <section class="market-summary">
    <h3 class="section-label">Job market &amp; business pulse</h3>
    <div class="pulse">{{ issue.marketPulse }}</div>
  </section>
  {% endif %}
</section>
{% endif %}
