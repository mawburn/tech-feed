<section class="page-intro" aria-labelledby="page-title">
  <div class="page-intro-copy">
    <p class="page-kicker">SOURCE-LINKED DAILY BRIEFINGS</p>
    <h1 id="page-title">{% if currentDay == 'all' %}Seven-day news archive{% else %}Technology &amp; AI <span>briefing</span>{% endif %}{% if filterCategory %} · {{ filterCategory }}{% endif %}</h1>
    <p>Every top story, roundup item, tool and market pulse, organized by briefing date.</p>
  </div>
  <div class="page-intro-status"><span class="pulse-dot" aria-hidden="true"></span><span>{% if feed.issues.length %}Latest · {{ feed.issues[0].date | dateShort }}{% else %}No editions yet{% endif %}</span></div>
</section>
<div class="content-divider">
  <span>THE LAST SEVEN DAYS</span>
  <span class="content-divider-right">{{ feed.issues.length }} editions</span>
</div>
<div class="layout">
  {% include "partials/daily-sidebar.njk" %}
  <main id="feed" class="feed">
    {% set currentIssues = feed.issues | getIssues(currentDay) %}
    {% set visibleStories = (currentIssues | storyList) | matchesCategory(filterCategory) %}
    {% set discussionTotal = visibleStories | threadCount %}
    <div class="toolbar">
      <div class="toolbar-copy">
        <span class="toolbar-kicker">{% if filterCategory %}TOPIC COVERAGE{% else %}LATEST COVERAGE{% endif %}</span>
        <span class="toolbar-count">{{ visibleStories.length }} stories</span>
        {% if discussionTotal %}
        <span class="discussion-summary">{{ discussionTotal }} HN/Reddit {% if discussionTotal == 1 %}link{% else %}links{% endif %} in this edition</span>
        {% else %}
        <span class="discussion-summary discussion-summary-empty">No matched discussion links yet</span>
        {% endif %}
      </div>
    </div>
    {% if currentIssues.length %}
      {% for issue in currentIssues %}
        {% include "partials/edition.njk" %}
      {% endfor %}
    {% else %}
      <div class="empty-state"><h3>No editions published</h3><p>The next briefing will appear here after it is published.</p></div>
    {% endif %}
  </main>
</div>
