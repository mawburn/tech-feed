{% if story.sources and story.sources.length %}
<div class="{% if secondary %}secondary-links{% else %}source-row{% endif %}">
  {% if not secondary %}<span class="source-label">SOURCES</span>{% endif %}
  {% for source in story.sources %}
  {% if source.url | isHttp %}<a class="source-link" href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.label or 'Source' }} ↗</a>{% endif %}
  {% endfor %}
</div>
{% endif %}

{% if story.discoveredVia and story.discoveredVia.length %}
<div class="community-meta found-via">
  <span class="community-label">FOUND VIA</span>
  {% for discovery in story.discoveredVia %}
    {% if discovery.url | isHttp %}
    <a class="community-link" href="{{ discovery.url }}" rel="noopener noreferrer" target="_blank">{{ discovery.platform or 'Source' }}{% if discovery.label and discovery.label != discovery.platform %} · {{ discovery.label }}{% endif %} ↗</a>
    {% endif %}
  {% endfor %}
</div>
{% endif %}
{% if story.discussions and story.discussions.length %}
<div class="community-meta discussion-links">
  <span class="community-label">COMMENTS</span>
  {% for discussion in story.discussions %}
    {% if discussion.url | isHttp %}
    <a class="community-link" href="{{ discussion.url }}" rel="noopener noreferrer" target="_blank">{{ discussion.platform or 'Discussion' }}{% if discussion.label and discussion.label != discussion.platform %} · {{ discussion.label }}{% endif %} ↗</a>
    {% endif %}
  {% endfor %}
</div>
{% endif %}

{% if not secondary %}
<details class="discussion-search">
  <summary>Find more discussion threads</summary>
  <div class="discussion-search-links">
    <a href="https://hn.algolia.com/?q={{ story.title | queryEncode }}" target="_blank" rel="noopener noreferrer">Search Hacker News ↗</a>
    <a href="https://www.reddit.com/search/?q={{ story.title | queryEncode }}" target="_blank" rel="noopener noreferrer">Search Reddit ↗</a>
  </div>
</details>
{% endif %}
