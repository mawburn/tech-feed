{% if story.sources and story.sources.length %}
<div class="{% if secondary %}secondary-links{% else %}source-row{% endif %}">
  {% if not secondary %}<span class="source-label">SOURCES</span>{% endif %}
  {% for source in story.sources %}
  {% if source.url | isHttp %}<a class="source-link" href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.label or 'Source' }} ↗</a>{% endif %}
  {% endfor %}
</div>
{% endif %}
