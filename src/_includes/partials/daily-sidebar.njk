{% set sidebarIssues = feed.issues | getIssues(currentDay) %}
{% set categoryCounts = sidebarIssues | topicCounts %}
<aside class="sidebar" aria-label="Archive dates and story topics">
  <div class="sidebar-sticky">
    <section class="topic-panel" aria-labelledby="topics-heading">
      <div class="topic-panel-heading">
        <h2 id="topics-heading" class="sidebar-kicker">{% if currentDay == 'all' %}TOPICS · ALL EDITIONS{% else %}TOPICS IN THIS EDITION{% endif %}</h2>
        <span class="topic-summary">{{ categoryCounts.length }} topics · {{ categoryCounts | sumTopicCounts }} stories</span>
      </div>
      <nav class="topic-nav" aria-label="Topics">
        <a class="topic-link" {% if not filterCategory %}aria-current="page"{% endif %} href="{{ currentDay | dayRoute | siteUrl }}">
          <span class="topic-name">All topics</span><span class="topic-count">{{ categoryCounts | sumTopicCounts }}</span>
        </a>
        {% for topic in categoryCounts %}
        <a class="topic-link" {% if filterCategory == topic.name %}aria-current="page"{% endif %} href="{{ currentDay | topicRoute(topic.name) | siteUrl }}">
          <span class="topic-name">{{ topic.name }}</span><span class="topic-count">{{ topic.count }}</span>
        </a>
        {% endfor %}
      </nav>
    </section>
    <section class="archive-panel">
      <h2 class="sidebar-kicker">EDITION ARCHIVE</h2>
      <nav class="date-nav" aria-label="Choose a briefing date">
        <a class="day-link" {% if currentDay == 'all' %}aria-current="page"{% endif %} href="{{ '/all/' | siteUrl }}"><span class="day-name">All editions</span><span class="day-count">{{ feed.issues.length }}</span></a>
        {% for day in feed.issues %}
        <a class="day-link" {% if day.date == currentDay %}aria-current="page"{% endif %} href="{{ day.date | dayRoute | siteUrl }}"><span class="day-name">{{ day.date | dateShort }}</span><span class="day-count">{{ [day] | totalStories }}</span></a>
        {% endfor %}
      </nav>
    </section>
    <p class="sidebar-note">Story counts reflect the selected date. Everything is available without JavaScript.</p>
  </div>
</aside>
